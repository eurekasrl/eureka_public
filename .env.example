# Used by docker-compose.yml. Copy to ".env" (gitignored) and change the values.

# SQL Server SA password: at least 8 characters mixing upper, lower, digits and symbols.
# Avoid "@", "%", "/" and "$": the password is embedded in the database URL.
MSSQL_SA_PASSWORD=Cambiami-Subito-2026

# Shared API key (X-API-Key). It is also baked into the frontend bundle.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=cambiami-con-una-chiave-casuale

# Optional: SMTP account used to email preventivi.
# INFO_EUREKA_MAIL_USER=info@example.com
# INFO_EUREKA_MAIL_PASSWORD=
# INFO_EUREKA_MAIL_HOST=smtp.example.com
# INFO_EUREKA_MAIL_PORT=465
