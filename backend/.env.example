DATABASE_URL = "mssql+pyodbc://@.\\SQLEXPRESS/eureka-dev?driver=ODBC+Driver+17+for+SQL+Server&trusted_connection=yes"

MOUNT_PATH_EUREKA = C:\<path_to_clienti_folder>

INFO_EUREKA_MAIL_USER= info@example.com
INFO_EUREKA_MAIL_PASSWORD = <smtp_password>
INFO_EUREKA_MAIL_HOST = smtp.example.com
INFO_EUREKA_MAIL_PORT = 465

# Shared secret for the API (X-API-Key). Must match frontend VITE_API_KEY.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=generate-a-strong-random-value

# Comma-separated browser origins allowed to call the API (add e.g. your Tailscale URL).
CORS_ORIGINS=http://localhost:5173

# --- OCR (scanned PDFs) ---
# Install Tesseract + the Italian language pack. On Windows, point at the exe:
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
# OCR_LANG=ita+eng
# OCR_DPI=300
